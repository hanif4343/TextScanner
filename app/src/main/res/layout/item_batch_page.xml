<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivPageStatus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_scan"
            android:tint="@color/text_secondary"
            android:contentDescription="Status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPageNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="পৃষ্ঠা 1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <ProgressBar
                    android:id="@+id/pageProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:indeterminateTint="@color/accent_blue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPageStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="অপেক্ষায়..."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRetryPage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_scan"
            android:tint="@color/accent_blue"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retry"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnDeletePage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
